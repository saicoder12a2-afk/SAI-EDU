# ─────────────────────────────────────────────
# Teacher Attendance App — Environment Variables
# Copy this file to .env and fill in values
# ─────────────────────────────────────────────

# Server port (leave as 3001 unless it conflicts)
PORT=3001

# Frontend URL for CORS (match your Vite dev server)
FRONTEND_URL=http://localhost:5173

# JWT secret — change this to a long random string in production!
JWT_SECRET=change_me_to_a_long_random_secret_key_at_least_32_chars

# JWT token expiry
JWT_EXPIRES_IN=24h

# Meta Cloud WhatsApp API
# NOTE: META_WA_PHONE_NUMBER_ID is the Meta Cloud phone number ID,
# not your regular WhatsApp number.
META_WA_PHONE_NUMBER_ID=your_meta_whatsapp_phone_number_id
META_WA_BUSINESS_ACCOUNT_ID=your_meta_whatsapp_business_account_id
META_WA_ACCESS_TOKEN=your_meta_whatsapp_access_token
